          "description": "Adult-content policy; endpoint-specific off/moderate/strict semantics are explained below.",
          "x-vendor-constraints": "`off`, `strict`; default `strict`"
        },
        "count": {
          "type": "integer",
          "minimum": 1.0,
          "maximum": 200.0,
          "default": 50,
          "description": "Requested result ceiling, not a guaranteed number; Web applies it only to web.results, Context uses it for candidate selection.",
          "x-vendor-constraints": "`1`-`200`; default `50`"
        },
        "spellcheck": {
          "type": "boolean",
          "default": true,
          "description": "Allow upstream spelling changes before searching; inspect query.altered rather than pretending the original phrase was executed unchanged.",
          "x-vendor-constraints": "default `true`"
        }
      },
      "additionalProperties": false,
      "required": [
