      "allOf": [
        {
          "if": {
            "required": [
              "fields"
            ]
          },
          "then": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "raw"
              }
            }
          }
        }
      ]
    }
