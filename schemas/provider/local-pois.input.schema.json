{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local POIs proposed provider input (not implemented)",
  "type": "object",
  "properties": {
    "operation": {
      "const": "local-pois"
    },
    "native": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 20,
          "description": "Temporary place identifiers obtained from search, valid for about eight hours; repeated query keys, one to twenty IDs per Web guide.",
          "x-vendor-constraints": ""
        },
        "search_lang": {
          "type": "string",
          "enum": [
            "ar",
            "eu",
            "bn",
            "bg",
            "ca",
            "zh-hans",
            "zh-hant",
            "hr",
            "cs",
            "da",
            "nl",
            "en",
            "en-gb",
            "et",
            "fi",
            "fr",
            "gl",
            "de",
            "el",
            "gu",
            "he",
            "hi",
            "hu",
            "is",
            "it",
            "ja",
            "jp",
            "kn",
            "ko",
            "lv",
            "lt",
            "ms",
            "ml",
            "mr",
            "nb",
            "pl",
            "pt-br",
            "pt-pt",
            "pa",
            "ro",
            "ru",
            "sr",
            "sk",
            "sl",
            "es",
            "sv",
            "ta",
            "te",
            "th",
            "tr",
            "uk",
            "vi"
          ],
          "default": "en",
          "description": "Preferred content language, not interface language. Codes identify languages; regional/script suffixes narrow the preference.",
          "x-vendor-constraints": "`ar`, `eu`, `bn`, `bg`, `ca`, `zh-hans`, `zh-hant`, `hr`, `cs`, `da`, `nl`, `en`, `en-gb`, `et`, `fi`, `fr`, `gl`, `de`, `el`, `gu`, `he`, `hi`, `hu`, `is`, `it`, `ja`, `jp`, `kn`, `ko`, `lv`, `lt`, `ms`, `ml`, `mr`, `nb`, `pl`, `pt-br`, `pt-pt`, `pa`, `ro`, `ru`, `sr`, `sk`, `sl`, `es`, `sv`, `ta`, `te`, `th`, `tr`, `uk`, `vi`; default `en`"
        },
        "ui_lang": {
          "type": "string",
          "enum": [
            "es-AR",
            "en-AU",
            "de-AT",
            "nl-BE",
            "fr-BE",
            "pt-BR",
            "en-CA",
            "fr-CA",
            "es-CL",
            "da-DK",
            "fi-FI",
            "fr-FR",
            "de-DE",
            "el-GR",
            "zh-HK",
            "en-IN",
            "en-ID",
            "it-IT",
            "ja-JP",
            "ko-KR",
            "en-MY",
            "es-MX",
            "nl-NL",
            "en-NZ",
            "no-NO",
            "zh-CN",
            "pl-PL",
            "en-PH",
            "ru-RU",
            "en-ZA",
            "es-ES",
            "sv-SE",
            "fr-CH",
            "de-CH",
            "zh-TW",
            "tr-TR",
            "en-GB",
            "en-US",
            "es-US"
          ],
          "default": "en-US",
          "description": "Language-region locale for presentation and metadata, not a translation request.",
          "x-vendor-constraints": "`es-AR`, `en-AU`, `de-AT`, `nl-BE`, `fr-BE`, `pt-BR`, `en-CA`, `fr-CA`, `es-CL`, `da-DK`, `fi-FI`, `fr-FR`, `de-DE`, `el-GR`, `zh-HK`, `en-IN`, `en-ID`, `it-IT`, `ja-JP`, `ko-KR`, `en-MY`, `es-MX`, `nl-NL`, `en-NZ`, `no-NO`, `zh-CN`, `pl-PL`, `en-PH`, `ru-RU`, `en-ZA`, `es-ES`, `sv-SE`, `fr-CH`, `de-CH`, `zh-TW`, `tr-TR`, `en-GB`, `en-US`, `es-US`; default `en-US`"
        },
        "units": {
          "type": "string",
          "enum": [
            "imperial",
            "metric"
          ],
          "description": "metric uses kilometres/Celsius; imperial uses miles/Fahrenheit. Response quantities carry their own unit fields.",
          "x-vendor-constraints": "`imperial`, `metric`"
        }
      },
      "additionalProperties": false,
      "required": [
        "ids"
      ]
    },
    "localization": {
      "type": "object",
      "properties": {
        "x-loc-lat": {
          "type": "string",
          "description": "User latitude in decimal degrees; a nonsecret, potentially sensitive location hint.",
          "x-vendor-constraints": "`-90`-`90`"
        },
        "x-loc-long": {
          "type": "string",
          "description": "User longitude in decimal degrees; a nonsecret, potentially sensitive location hint.",
          "x-vendor-constraints": "`-180`-`180`"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "raw",
            "brief",
            "links"
          ],
          "default": "brief"
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 10
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144,
          "default": 32768
        },
        "fields": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "fields"
            ]
          },
          "then": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "raw"
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "operation",
    "native"
  ]
}
