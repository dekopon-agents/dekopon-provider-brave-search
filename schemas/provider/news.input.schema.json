        "max_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144,
          "default": 32768
        },
        "fields": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "fields"
            ]
          },
          "then": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "raw"
              }
            }
          }
        }
