{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "News Search upstream 200 documented-shape schema",
  "description": "All fetched reference 200 field paths are represented; guide-only Context metadata is added. Unknown properties are allowed, and optional reference fields allow null. Requiredness is intentionally not enforced because these are variable vendor models, not exhaustive validation.",
  "x-source": "https://api-dashboard.search.brave.com/api-reference/news/news_search/get/index.html.md",
  "type": "object",
  "properties": {
    "type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Vendor field; semantic details/units are not specified in the fetched reference."
    },
    "query": {
      "type": "object",
      "properties": {
        "original": {
          "type": "string",
          "description": "Original user phrase (or original asset URL within a thumbnail)."
        },
        "altered": {
          "type": [
            "string",
            "null"
          ],
          "description": "Spelling-corrected phrase actually used upstream."
        },
        "cleaned": {
          "type": [
            "string",
            "null"
          ],
          "description": "Normalized query text."
        },
        "spellcheck_off": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Spellcheck off metadata/value within this model."
        },
        "show_strict_warning": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Indicates results were reduced by strict safety filtering."
        },
        "search_operators": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "applied": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Applied metadata/value within this model."
            },
            "cleaned_query": {
              "type": [
                "string",
                "null"
              ],
              "description": "Cleaned query metadata/value within this model."
            },
            "sites": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              },
              "description": "Sites collection."
            }
          },
          "additionalProperties": true,
          "description": "Search operators metadata/value within this model."
        }
      },
      "additionalProperties": true,
      "description": "Query metadata object, or corrected/completed phrase on suggestion/spellcheck items."
    },
    "results": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "string",
              "null"
            ],
            "description": "Documented discriminator `news_result` identifies this enclosing model; unknown future tags remain accepted."
          },
          "title": {
            "type": "string",
            "description": "Title metadata/value within this model."
          },
          "url": {
            "type": "string",
            "description": "Source/page URL in result records; URL meaning follows the enclosing model (image properties and profiles differ)."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Display description/excerpt; POI Descriptions text is generated and Context source description is query-independent."
          },
          "age": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable age; Context sources use a separate four-position date array."
          },
          "page_age": {
            "type": [
              "string",
              "null"
            ],
            "description": "Content publication/modification date, not necessarily crawl time."
          },
          "page_fetched": {
            "type": [
              "string",
              "null"
            ],
            "description": "Last-fetch date/time as provided by the vendor."
          },
          "profile": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name metadata/value within this model."
              },
              "url": {
                "type": "string",
                "description": "Source/page URL in result records; URL meaning follows the enclosing model (image properties and profiles differ)."
              },
              "long_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Long name metadata/value within this model."
              },
              "img": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Img metadata/value within this model."
              }
            },
            "additionalProperties": true,
            "description": "Profile metadata/value within this model."
          },
          "fetched_content_timestamp": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Fetch timestamp; do not infer units beyond the source contract."
          },
          "meta_url": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "scheme": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Scheme metadata/value within this model."
              },
              "netloc": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Netloc metadata/value within this model."
              },
              "hostname": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Hostname metadata/value within this model."
              },
              "favicon": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Favicon metadata/value within this model."
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Path metadata/value within this model."
              }
            },
            "additionalProperties": true,
            "description": "Meta url metadata/value within this model."
          },
          "breaking": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Breaking metadata/value within this model."
          },
          "thumbnail": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "src": {
                "type": "string",
                "description": "Src metadata/value within this model."
              },
              "original": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Original user phrase (or original asset URL within a thumbnail)."
              }
            },
            "additionalProperties": true,
            "description": "Thumbnail metadata/value within this model."
          },
          "extra_snippets": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Alternative page excerpts, not continuous full text."
          },
          "icons": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "properties": {
                "href": {
                  "type": "string",
                  "description": "Vendor field; semantic details/units are not specified in the fetched reference."
                },
                "sizes": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Vendor field; semantic details/units are not specified in the fetched reference."
                },
                "rel": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Vendor field; semantic details/units are not specified in the fetched reference."
                },
                "type": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Vendor field; semantic details/units are not specified in the fetched reference."
                },
                "ext": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Vendor field; semantic details/units are not specified in the fetched reference."
                }
              },
              "additionalProperties": true
            },
            "description": "Icons collection."
          }
        },
        "additionalProperties": true
      },
      "description": "Results collection."
    }
  },
  "additionalProperties": true
}
